# Upstream reference checkouts pulled by init.sh — never commit these.
# No trailing slash: in worktrees init.sh creates these as symlinks, which a
# directory-only pattern (`/pokeemerald/`) would not match. These anchored
# patterns ignore a dir or a symlink of that name.
/pokeemerald
/mgba

# Rust build output
/target/
**/*.rs.bk
Cargo.lock.bak

# Editor / OS noise
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and local scratch
*.log
/tmp/
/scratch/

# Python bytecode cache
__pycache__/
*.pyc
